{
  "$comment": "What CodeNotch adds to Orca's catalog: which CLIs it reads quotas for, their logo in gpui-app/assets/glyphs.json, and install commands verified for Windows. Agents absent here come from Orca as is. Run `bun run sync:agents` after editing.",
  "exclude": ["claude-agent-teams"],
  "agents": {
    "claude": { "quota": "claude", "logo": "claude", "install": "irm https://claude.ai/install.ps1 | iex" },
    "codex": { "quota": "codex", "logo": "openai", "name": "Codex / ChatGPT", "install": "npm i -g @openai/codex" },
    "gemini": { "quota": "gemini", "logo": "gemini", "install": "npm i -g @google/gemini-cli" },
    "grok": { "quota": "grok", "logo": "grok" },
    "opencode": { "quota": "opencode", "logo": "opencode", "install": "npm i -g opencode-ai" },
    "copilot": { "quota": "copilot", "logo": "copilot", "install": "npm i -g @github/copilot" }
  }
}
