{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeNotch Windows",
  "version": "0.1.3",
  "identifier": "dev.kev.smashtoken",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1437",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CodeNotch — Settings",
        "width": 860,
        "height": 690,
        "minWidth": 600,
        "minHeight": 500,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0e0e10",
        "focus": false,
        "visible": false
      },
      {
        "label": "widget",
        "title": "CodeNotch",
        "url": "index.html?widget=1",
        "width": 74,
        "height": 378,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1437 http://127.0.0.1:1437; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Vos comptes IA, à portée de regard.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5OTZDMDU4N0JCNERDMTIKUldRUzNMUjdXTUNXNlZhS0Q3QkNwblVTaHcrVGFvSmZhT2xWazlNNnpCSHNmbmZVTDloR1lGM1MK",
      "endpoints": [
        "https://github.com/MakFly/codenotch-windows/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
