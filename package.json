{
  "name": "smashtoken",
  "version": "0.2.1",
  "description": "A Windows desktop notch for local AI account quotas and usage.",
  "license": "MIT",
  "author": "Kev (MakFly)",
  "repository": {
    "type": "git",
    "url": "https://github.com/MakFly/codenotch-windows.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "desktop": "cargo run --manifest-path gpui-app/Cargo.toml",
    "desktop:settings": "cargo run --manifest-path gpui-app/Cargo.toml -- --settings",
    "desktop:build": "cargo build --release --manifest-path gpui-app/Cargo.toml",
    "test": "cargo test --manifest-path gpui-app/Cargo.toml",
    "check": "cargo check --manifest-path gpui-app/Cargo.toml",
    "release:package": "bun scripts/package-release.ts",
    "sync:agents": "bun scripts/sync-cli-agents.ts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/bun": "latest"
  }
}
