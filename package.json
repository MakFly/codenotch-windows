{
  "name": "smashtoken",
  "version": "0.1.1",
  "description": "A Windows desktop notch for local AI account quotas and usage.",
  "license": "MIT",
  "author": "Kev (MakFly)",
  "repository": {
    "type": "git",
    "url": "https://github.com/MakFly/codenotch-windows.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "release:package": "bun scripts/package-release.ts",
    "check": "tsc -b",
    "test": "bun test tests",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:native": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:ui": "bun scripts/test-notch.ts && bun scripts/test-notch-motion.ts && bun scripts/test-settings-dialog.ts && bun scripts/test-localization.ts && bun scripts/test-quick-connect.ts && bun scripts/test-welcome.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.2.6",
    "@tauri-apps/api": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@playwright/test": "^1.56.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
